{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "circle-search-overlay",
  "description": "Capabilities for dynamic Circle to Search overlay window",
  "windows": ["circle-search-overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:webview:default",
    "core:event:default"
  ]
}
